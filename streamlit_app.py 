#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
MLB Portfolio App — All-in-One (Real Data, No-Fail)
- 실데이터: output/player_cards_all.parquet (1901–) + output/statcast_ultra_full_clean.parquet (2015–)
- 요약/시각화: output/summaries/*, output/reports/*
- 기능:
  1) 데이터 상태 점검(실데이터 범위/행수)
  2) 선수 검색(카드 기반, 최근 3년 트렌드 표/간단 라인)
  3) 리포트 & 시각화 뷰어(플래툰, 약점 히트맵, EUZ, 트렌드카드)
  4) PRO 트레이드 평가(실데이터 3년 복합점수: WAR, wRC+, EV, BB/K, AGE)
- 모든 결함은 UI 경고로 처리, 앱은 절대 죽지 않음.
"""

import os, json, io, math, traceback
from pathlib import Path
import pandas as pd
import numpy as np
import streamlit as st

# ===== 경로 & 파일 =====
ROOT = Path(".").resolve()
OUT  = ROOT/"output"
REP  = OUT/"reports"
SUM  = OUT/"summaries"

F_CARDS   = OUT/"player_cards_all.parquet"                # 1901–2014+ (Lahman/Chadwick card 계열)
F_CARDS_EN= OUT/"player_cards_enriched_all_seq.parquet"   # 있으면 사용
F_STAT    = OUT/"statcast_ultra_full_clean.parquet"       # 2015–2025 (Statcast)
# 시각화/요약(있으면 노출)
V_PLATOON_CSV = SUM/"platoon_split.csv"
V_PLATOON_PNG = REP/"platoon_map.png"
V_WEAK_CSV    = SUM/"weakness_heatmap_matrix.csv"
V_WEAK_PNG    = REP/"weakness_heatmap.png"
V_TREND_PDF   = REP/"trend_cards_3y.pdf"
V_EUZ_CSV     = SUM/"euz_umpire_impact.csv"
V_EUZ_PNG     = REP/"ump_euz.png"
V_EXPLAIN_PNG = REP/"explainable_attribution_topN.png"
R_AUTO_PDF    = REP/"auto_report_v2.pdf"
R_LEG_PDF     = REP/"legacy_report_v2.pdf"

st.set_page_config(page_title="MLB Portfolio (Real Data)", layout="wide")

# ===== 공통 유틸 =====
def _exists(p: Path) -> bool:
    try: return p.exists()
    except: return False

@st.cache_data(show_spinner=False)
def _read_parquet_safe(path: Path, columns: list[str] | None = None):
    if not _exists(path):
        return None, f"missing: {path}"
    try:
        df = pd.read_parquet(path, columns=columns)
        return df, None
    except Exception as e:
        return None, f"read_parquet failed: {path.name} ({e})"

def _safe_num(s):
    return pd.to_numeric(s, errors="coerce")

def _head(df, n=10):
    try: return df.head(n)
    except: return df

def _fmt_int(v):
    try: return f"{int(v):,}"
    except: return "—"

def _img(path: Path, caption: str):
    if _exists(path):
        st.image(str(path), caption=caption, use_container_width=True)
    else:
        st.info(f"파일 없음: {path.name}")

def _pdf(url_or_path: Path, label: str):
    if _exists(url_or_path):
        with open(url_or_path, "rb") as f:
            st.download_button(label=f"📄 {label} 다운로드", data=f.read(), file_name=url_or_path.name, mime="application/pdf")
    else:
        st.info(f"PDF 없음: {url_or_path.name}")

# ===== 데이터 로더 =====
@st.cache_data(show_spinner=False)
def load_cards():
    # enriched 우선, 없으면 기본
    if _exists(F_CARDS_EN):
        df, err = _read_parquet_safe(F_CARDS_EN)
        if df is not None: return df
    df, err = _read_parquet_safe(F_CARDS)
    return df

@st.cache_data(show_spinner=False)
def load_statcast():
    df, err = _read_parquet_safe(F_STAT)
    return df

# ===== 컬럼 동의어 매핑 =====
def _first_col(df, candidates, default=None):
    for c in candidates:
        if c in df.columns: return c
    return default

def _cards_map(df):
    return {
        "name":   _first_col(df, ["player_name","name","PlayerName"], "player_name"),
        "pid":    _first_col(df, ["player_id","mlbam_id","retro_id","playerid","key_bbref"], "player_id"),
        "season": _first_col(df, ["season","Year","year"], "season"),
        "team":   _first_col(df, ["team","Team","Tm"], None),
        "pos":    _first_col(df, ["primary_pos","pos","position"], None),
        "age":    _first_col(df, ["age","Age"], None),
        "war":    _first_col(df, ["WAR","war","fWAR","bWAR","WAR3"], None),
        "wrc":    _first_col(df, ["wRC_plus","wRC+","wrc_plus"], None),
        "ev":     _first_col(df, ["EV","avg_ev","avg_exit_velocity","exit_velo"], None),
        "bb":     _first_col(df, ["BB%","bb_rate","BB"], None),
        "k":      _first_col(df, ["K%","k_rate","K"], None),
        "pa":     _first_col(df, ["PA","pa"], None),
    }

# ===== 개요 섹션 =====
def section_overview():
    st.header("📦 데이터 개요 / 상태")
    cdf = load_cards()
    sdf = load_statcast()

    colA, colB = st.columns(2)
    with colA:
        st.subheader("Cards (1901–)")
        if cdf is None:
            st.warning(f"{F_CARDS.name} / {F_CARDS_EN.name} 없음")
        else:
            cm = _cards_map(cdf)
            seas = _safe_num(cdf[cm["season"]]) if cm["season"] in cdf.columns else pd.Series(dtype="float")
            st.write({
                "rows": _fmt_int(len(cdf)),
                "season[min,max]": [seas.min(), seas.max()] if len(seas) else None,
                "columns": len(cdf.columns)
            })
            st.dataframe(_head(cdf[[c for c in [cm["name"], cm["team"], cm["pos"], cm["season"], cm["war"], cm["wrc"], cm["ev"], cm["pa"]] if c in cdf.columns]].copy(), 15), use_container_width=True)

    with colB:
        st.subheader("Statcast (2015–)")
        if sdf is None:
            st.warning(f"{F_STAT.name} 없음")
        else:
            ycol = "year" if "year" in sdf.columns else ("game_year" if "game_year" in sdf.columns else None)
            seas = _safe_num(sdf[ycol]) if ycol else pd.Series(dtype="float")
            st.write({
                "rows": _fmt_int(len(sdf)),
                "year[min,max]": [seas.min(), seas.max()] if len(seas) else None,
                "columns": len(sdf.columns)
            })
            st.dataframe(_head(sdf[[ycol] + [c for c in ["batter","pitcher","launch_speed","plate_x","plate_z"] if c in sdf.columns]].copy(), 15), use_container_width=True)

# ===== 선수 검색 / 3y 트렌드 =====
def _last_n(df, cm, pid, n=3):
    s = cm["season"]
    sl = df[df[cm["pid"]]==pid].copy()
    if sl.empty: return sl
    ymax = int(pd.to_numeric(sl[s], errors="coerce").max())
    return sl[sl[s].between(ymax-n+1, ymax)]

def section_player_search():
    st.header("🔎 선수 검색 & 3년 트렌드")
    cdf = load_cards()
    if cdf is None:
        st.warning("카드 데이터 부재")
        return
    cm = _cards_map(cdf)
    # 이름 목록 (대형이면 상위 N개만)
    names = cdf[cm["name"]].dropna().astype(str).value_counts().head(5000).index.tolist()
    q = st.text_input("선수 이름(포함검색 가능)", value="Mookie Betts")
    if not q:
        st.info("선수명을 입력하세요.")
        return
    # 매칭
    hit = cdf[cdf[cm["name"]].astype(str).str.contains(q, case=False, na=False)]
    if hit.empty:
        st.warning("일치 선수 없음")
        return
    pid = hit[cm["pid"]].value_counts().idxmax()
    last3 = _last_n(cdf, cm, pid, 3)
    st.write("**선수 식별**", {
        "player_id": pid,
        "player_name": hit[cm["name"]].iloc[0],
        "seasons": list(last3[cm["season"]].astype("Int64")) if cm["season"] in last3.columns else None
    })
    # 표
    cols_show = [c for c in [cm["season"], cm["team"], cm["pos"], cm["war"], cm["wrc"], cm["ev"], cm["bb"], cm["k"], cm["pa"], cm["age"]] if c in last3.columns]
    if cols_show:
        st.dataframe(last3[cols_show], use_container_width=True)
    # 간단 라인(텍스트로)
    def _mean(col):
        return round(float(pd.to_numeric(last3.get(col, pd.Series(dtype='float')), errors="coerce").mean()),3) if col in last3.columns and len(last3) else None
    st.write("**3y 평균**", {"WAR":_mean(cm["war"]), "wRC+":_mean(cm["wrc"]), "EV":_mean(cm["ev"]), "BB%":_mean(cm["bb"]), "K%":_mean(cm["k"])})

