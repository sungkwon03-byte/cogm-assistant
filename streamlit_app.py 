# ===== PRO 트레이드 평가 (3년 복합) =====
WEIGHTS = {
    "WAR3": 0.55, "WRC3": 0.25, "EV3": 0.10, "AGE": -0.05, "VOL": 0.05
}

def _league_baselines(df, cm):
    # 아주 간단한 전체 평균
    def M(c, default):
        return float(pd.to_numeric(df[c], errors="coerce").mean()) if c and c in df.columns else default
    return {"WAR": M(cm["war"], 0.0), "WRC": M(cm["wrc"], 100.0), "EV": M(cm["ev"], 88.0),
            "BB": M(cm["bb"], 8.0), "K": M(cm["k"], 22.0), "AGE": M(cm["age"], 28.0)}

def _component_score(val, base, scale):
    if val is None or pd.isna(val): return 0.0
    return (val - base) / (scale if scale else 1.0)

def _player_profile(cards, cm, name_query):
    hit = cards[cards[cm["name"]].astype(str).str.contains(name_query, case=False, na=False)]
    if hit.empty: return None, f"'{name_query}' 대상 없음"
    pid = hit[cm["pid"]].value_counts().idxmax()
    last3 = _last_n(cards, cm, pid, 3)
    if last3.empty: return None, f"'{name_query}' 최근 3시즌 데이터 없음"
    base = _league_baselines(cards, cm)

    def mean_col(c): 
        return float(pd.to_numeric(last3[c], errors="coerce").mean()) if c and c in last3.columns else np.nan
    WAR3 = mean_col(cm["war"]); WRC3 = mean_col(cm["wrc"]); EV3 = mean_col(cm["ev"])
    BB3  = mean_col(cm["bb"]);  K3   = mean_col(cm["k"]);   AGE3= mean_col(cm["age"])

    sc_war = _component_score(WAR3, base["WAR"], 1.0) * WEIGHTS["WAR3"]
    sc_wrc = _component_score(WRC3, base["WRC"], 10.0) * WEIGHTS["WRC3"]
    sc_ev  = _component_score(EV3,  base["EV"],  2.5)  * WEIGHTS["EV3"]

    sc_vol = 0.0
    if not pd.isna(BB3): sc_vol += _component_score(BB3, base["BB"], 3.0)
    if not pd.isna(K3):  sc_vol -= _component_score(K3, base["K"],  4.0)
    sc_vol *= WEIGHTS["VOL"]

    sc_age = 0.0
    if not pd.isna(AGE3):
        if AGE3 <= 24: sc_age = + (24-AGE3) * 0.05
        if AGE3 >= 30: sc_age = - (AGE3-30) * 0.04
    sc_age *= abs(WEIGHTS["AGE"])

    total = float(sc_war + sc_wrc + sc_ev + sc_vol + sc_age)

    profile = {
        "player_id": pid,
        "player_name": last3[cm["name"]].iloc[-1],
        "seasons": list(last3[cm["season"]].astype("Int64")) if cm["season"] in last3.columns else None,
        "WAR3": None if pd.isna(WAR3) else round(WAR3,3),
        "WRC3": None if pd.isna(WRC3) else round(WRC3,3),
        "EV3":  None if pd.isna(EV3)  else round(EV3,3),
        "BB3":  None if pd.isna(BB3)  else round(BB3,3),
        "K3":   None if pd.isna(K3)   else round(K3,3),
        "AGE":  None if pd.isna(AGE3) else round(AGE3,1),
        "score_components": {
            "WAR3": round(sc_war,4), "WRC3": round(sc_wrc,4), "EV": round(sc_ev,4),
            "VOL": round(sc_vol,4), "AGE": round(sc_age,4)
        },
        "score_total": round(total,4)
    }
    return profile, None

def section_trade_pro():
    st.header("🔁 Trade Evaluator — PRO (Real 3Y Composite)")
    cards = load_cards()
    if cards is None:
        st.warning("카드 데이터 부재")
        return
    cm = _cards_map(cards)
    c1, c2 = st.columns(2)
    with c1:
        ta = st.text_area("Team A players (comma or newline)", value="Mookie Betts\nFreddie Freeman")
    with c2:
        tb = st.text_area("Team B players (comma or newline)", value="Aaron Judge\nJuan Soto")
    if st.button("Evaluate Trade"):
        def team_score(txt):
            names = [x.strip() for x in txt.replace("\n",",").split(",") if x.strip()]
            profs, errs = [], []
            for nm in names:
                p, err = _player_profile(cards, cm, nm)
                if err: errs.append(f"{nm}: {err}")
                else:  profs.append(p)
            total = round(sum(p["score_total"] for p in profs),4) if profs else 0.0
            return profs, total, errs

        A, As, Ae = team_score(ta)
        B, Bs, Be = team_score(tb)
        st.write("### Team Scores", {"TeamA": As, "TeamB": Bs, "Δ(A-B)": round(As-Bs,4)})
        if A: st.write("**Team A**"); st.json({p["player_name"]: p for p in A})
        if B: st.write("**Team B**"); st.json({p["player_name"]: p for p in B})
        if Ae or Be: st.warning(" / ".join(Ae+Be))

# ===== 메인 탭 =====
def main():
    st.title("MLB Portfolio — Real Data (1901–2025)")

    tabs = st.tabs(["1) 개요", "2) 선수 검색", "3) 리포트·시각화", "4) PRO 트레이드"])
    with tabs[0]:
        try: section_overview()
        except Exception:
            st.error("개요 섹션 오류")
            st.code(traceback.format_exc())
    with tabs[1]:
        try: section_player_search()
        except Exception:
            st.error("선수 검색 섹션 오류")
            st.code(traceback.format_exc())
    with tabs[2]:
        try: section_visuals_reports()
        except Exception:
            st.error("리포트/시각화 섹션 오류")
            st.code(traceback.format_exc())
    with tabs[3]:
        try: section_trade_pro()
        except Exception:
            st.error("트레이드 섹션 오류")
            st.code(traceback.format_exc())

    st.caption("데이터 소스: Statcast(2015–), Lahman/Chadwick 계열 카드(1901–). 모든 계산은 실데이터 기반이며, 누락 컬럼은 0 기여로 방어적으로 처리합니다.")

if __name__ == "__main__":
    main()
